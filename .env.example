# ============================================================
# Vorlage für die Server-Umgebungsvariablen.
#
# Diese Datei wird eingecheckt und enthält KEINE echten Werte.
# Echte Secrets gehören in .env.local (ist über .gitignore
# ausgeschlossen) bzw. in die Secret-Verwaltung des Hosters.
#
# WICHTIG: Alles mit VITE_-Präfix landet im Browser-Bundle und ist
# damit öffentlich. Echte Geheimnisse dürfen NIE ein VITE_-Präfix haben.
# ============================================================

# ---------- Supabase ----------
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_PUBLISHABLE_KEY=            # anon key, darf öffentlich sein
SUPABASE_SERVICE_ROLE_KEY=           # GEHEIM, umgeht RLS, nie ins Frontend
VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------- Cron- und Webhook-Schutz ----------
# Schützt /api/public/hooks/* (Service-Role, umgeht RLS).
# Erzeugen mit: openssl rand -hex 32
# Aufruf: Authorization: Bearer <CRON_SECRET>
# Ohne diesen Wert sind die Hook-Endpunkte gesperrt (fail closed).
CRON_SECRET=
CREATOMATE_WEBHOOK_SECRET=

# ---------- OAuth der Social-Plattformen ----------
# Verschlüsselung der gespeicherten Tokens (AES-256-GCM) und Signatur
# des OAuth-State. Beide GEHEIM, beliebig lange Zufallsstrings.
SOCIAL_TOKEN_KEY=
SOCIAL_STATE_SECRET=

GOOGLE_CLIENT_ID=                    # YouTube: console.cloud.google.com
GOOGLE_CLIENT_SECRET=
META_APP_ID=                         # Instagram + Facebook: developers.facebook.com
META_APP_SECRET=
TIKTOK_CLIENT_KEY=                   # developers.tiktok.com
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=                         # developer.x.com
X_CLIENT_SECRET=

# Öffentliche Basis-URL der App (für OAuth-Redirects und Webhooks)
PUBLIC_APP_URL=https://deine-domain.de

# ---------- Render-Provider ----------
CREATOMATE_API_KEY=
CREATOMATE_CONCURRENCY=3
CREATOMATE_COST_PER_MINUTE=
SHOTSTACK_API_KEY=
JSON2VIDEO_API_KEY=
CUSTOM_RENDER_API_URL=               # eigene ffmpeg-Maschine, siehe docs/CUSTOM-RENDER-API.md
CUSTOM_RENDER_API_KEY=

# ---------- KI / Transkription / Generierung ----------
LOVABLE_API_KEY=                     # Lovable AI Gateway
GROQ_API_KEY=                        # Whisper-Transkription
FAL_KEY=                             # fal.ai (Video, Bild, Face-Swap)
FAL_VIDEO_MODEL=
FAL_IMAGE_MODEL=
FAL_FACESWAP_MODEL=

# ---------- YouTube-Import ----------
COBALT_API_URL=
COBALT_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_YTDL_HOST=
YT_IMPORT_MAX_MB=500
