# KaramsVids Worker: Konfiguration
# Diese Datei nach .env kopieren und ausfuellen. Die .env bleibt lokal auf diesem Rechner.

# ---------------------------------------------------------------- Pflicht

# Adresse des Supabase-Projekts (Supabase-Dashboard > Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Service-Role-Schluessel (Project Settings > API > service_role). Umgeht RLS, deshalb NUR
# auf diesem Rechner benutzen, nie in die Web-App oder ins Repo.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --------------------------------------------------------------- Optional

# Transkription ueber Groq (whisper-large-v3-turbo) statt lokal mit faster-whisper.
# Schneller und genauer als das lokale small-Modell, kostet etwa 0,04 $ je Audiostunde.
# Leer lassen = lokal transkribieren (kostenlos, nur CPU).
GROQ_API_KEY=

# Auswahl der Stellen per Sprachmodell ueber das Lovable-AI-Gateway (derselbe Schluessel wie in
# der Web-App). Leer lassen = eingebaute Heuristik (Hook-Woerter, Fragen, Zahlen, Tempo, Pausen).
LOVABLE_API_KEY=

# Lokales Whisper-Modell: tiny, base, small (Standard), medium. Groesser = genauer, langsamer.
# Richtwert auf dem i5-10210U: small etwa 1,5x bis 3x Echtzeit, tiny etwa 5x Echtzeit.
WHISPER_MODEL=small

# Beam-Breite fuer faster-whisper: 1 = schnell, 5 = genauer (Standard 5)
WHISPER_BEAM=5

# Arbeitsordner fuer Quellen, WAV, Untertitel und fertige Clips.
# Standard: %LOCALAPPDATA%\KaramsVids\work
WORK_DIR=

# Name dieses Workers (steht im Auftrag unter options.worker_id). Standard: Rechnername-PID
WORKER_ID=

# Abstand zwischen zwei Abfragen nach neuen Auftraegen in Sekunden (Standard 10)
POLL_SECONDS=10

# Fester Pfad zu ffmpeg.exe, falls ffmpeg nicht im PATH liegt (ffprobe muss daneben liegen)
FFMPEG_PATH=

# Modell hinter dem Lovable-Gateway fuer die Auswahl (Standard google/gemini-2.5-flash)
LOVABLE_MODEL=google/gemini-2.5-flash

# Arbeitsordner eines Auftrags nach Erfolg behalten (1 = ja), zum Nachschauen
KEEP_WORK=0

# Groq-Modell fuer die Transkription (nur mit GROQ_API_KEY), Standard whisper-large-v3-turbo
GROQ_MODEL=whisper-large-v3-turbo
